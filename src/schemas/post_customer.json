{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "legal_name",
    "email",
    "cpf",
    "cnpj",
    "birthdate",
    "phone",
    "password",
    "transaction_pin"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "legal_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "maxLength": 255
    },
    "cpf": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "cnpj": {
      "type": "string",
      "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2}$"
    },
    "birthdate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "phone": {
      "type": "string",
      "minLength": 10,
      "maxLength": 20
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "transaction_pin": {
      "type": "string",
      "pattern": "^\\d{4}$"
    }
  }
}
